<section class="product-grid-section">
  <div class="container">
    <h2>Featured Products</h2>
    <div class="product-grid">
      {% for product in shop.products limit: 8 %}
        <div class="product-card">
          <div class="product-image">
            <img src="{{ product.featured_image | img_url: '400x400' }}" alt="{{ product.title }}">
          </div>
          <div class="product-info">
            <h3>{{ product.title }}</h3>
            <p class="product-price">${{ product.price | money }}</p>
            <a href="{{ product.url }}" class="view-link">View Product</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .product-grid-section {
    padding: 80px 20px;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .product-grid-section h2 {
    font-size: 42px;
    text-align: center;
    margin-bottom: 60px;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 30px;
  }
  .product-card {
    transition: transform 0.3s ease;
  }
  .product-card:hover {
    transform: translateY(-5px);
  }
  .product-image {
    margin-bottom: 20px;
    background: #f9f9f9;
    aspect-ratio: 1;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .product-price {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 15px;
  }
  .view-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    color: #000;
    border-bottom: 2px solid #000;
  }
</style>

{% schema %}
{
  "name": "Product Grid",
  "settings": [],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}