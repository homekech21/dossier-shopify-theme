<section class="product-grid-section">
  <div class="container">
    <h2>{{ section.settings.title }}</h2>
    <div class="product-grid">
      {% for product in collection.products %}
        <div class="product-card">
          <div class="product-image">
            <img src="{{ product.featured_image | img_url: '400x400' }}" alt="{{ product.title }}">
          </div>
          <div class="product-info">
            <h3>{{ product.title }}</h3>
            <p class="product-price">${{ product.price | money }}</p>
            <a href="{{ product.url }}" class="view-link">View Product</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .product-grid-section {
    padding: 80px 20px;
    background: #fff;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-grid-section h2 {
    font-size: 42px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 60px;
    letter-spacing: -0.5px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 30px;
  }

  .product-card {
    transition: transform 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-image {
    overflow: hidden;
    margin-bottom: 20px;
    background: #f9f9f9;
    aspect-ratio: 1;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  .product-info h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .product-price {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 15px;
    color: #000;
  }

  .view-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #000;
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 2px solid #000;
    transition: opacity 0.3s;
  }

  .view-link:hover {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .product-grid-section h2 {
      font-size: 28px;
      margin-bottom: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
