<section class="hero" style="background-image: url('https://via.placeholder.com/1400x600');">
  <div class="hero-content">
    <h1>Welcome to Our Store</h1>
    <p>Discover our curated collection</p>
    <a href="/collections/all" class="button">Shop Now</a>
  </div>
</section>

<style>
  .hero {
    height: 600px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero h1 {
    font-size: 56px;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .hero p {
    font-size: 20px;
    margin-bottom: 30px;
  }
  .button {
    display: inline-block;
    padding: 15px 40px;
    background: white;
    color: black;
    text-decoration: none;
    font-weight: 600;
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}